# Supabase Configuration
# Found in your Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth Configuration
# Web Client ID is required for google_sign_in to obtain serverAuthCode/idToken if linking with backend
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Android Client ID (generated in Google Cloud Console using your SHA-1 and package name com.mailmind.app)
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# LLM & Embedding Model URLs (for later phases)
LLM_MODEL_NAME=Llama-3.2-1B-Instruct-Q4_K_M.gguf
LLM_MODEL_URL=https://huggingface.co/bartowski/Llama-3.2-1B-Instruct-GGUF/resolve/main/Llama-3.2-1B-Instruct-Q4_K_M.gguf
EMBEDDING_MODEL_NAME=nomic-embed-text-v1.5.Q4_K_M.gguf
EMBEDDING_MODEL_URL=https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF/resolve/main/nomic-embed-text-v1.5.Q4_K_M.gguf

